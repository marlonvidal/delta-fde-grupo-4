{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fde/saidas/triagem.schema.json",
  "title": "Saída triagem 0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caso_id",
    "modulo",
    "versao_contrato",
    "status_execucao",
    "justificativa",
    "evidencias_ids",
    "regras_ids",
    "lacunas",
    "conflitos",
    "proximas_acoes",
    "requer_decisao_humana",
    "encaminhamento",
    "gatilhos",
    "achados_secundarios"
  ],
  "properties": {
    "caso_id": {
      "type": "string",
      "minLength": 1
    },
    "modulo": {
      "const": "triagem"
    },
    "versao_contrato": {
      "const": "0.2.0"
    },
    "status_execucao": {
      "enum": [
        "CONCLUIDO",
        "INSUFICIENTE",
        "FORA_ESCOPO",
        "ENTRADA_INVALIDA",
        "ERRO_EXECUCAO"
      ]
    },
    "justificativa": {
      "type": "string",
      "minLength": 1
    },
    "evidencias_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "regras_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lacunas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "codigo",
          "campo",
          "descricao",
          "evidencias_ids",
          "regras_ids"
        ],
        "properties": {
          "codigo": {
            "type": "string",
            "minLength": 1
          },
          "campo": {
            "type": "string",
            "minLength": 1
          },
          "descricao": {
            "type": "string",
            "minLength": 1
          },
          "evidencias_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "regras_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "conflitos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "codigo",
          "campo",
          "descricao",
          "evidencias_ids",
          "regras_ids"
        ],
        "properties": {
          "codigo": {
            "type": "string",
            "minLength": 1
          },
          "campo": {
            "type": "string",
            "minLength": 1
          },
          "descricao": {
            "type": "string",
            "minLength": 1
          },
          "evidencias_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "regras_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "proximas_acoes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "codigo",
          "descricao",
          "responsavel",
          "evidencias_ids",
          "regras_ids"
        ],
        "properties": {
          "codigo": {
            "type": "string",
            "minLength": 1
          },
          "descricao": {
            "type": "string",
            "minLength": 1
          },
          "responsavel": {
            "const": "ANALISTA_HUMANO"
          },
          "evidencias_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "regras_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "requer_decisao_humana": {
      "const": true
    },
    "encaminhamento": {
      "enum": [
        "FORA_ESCOPO",
        "REVISAO_ESPECIALIZADA",
        "REVISAO_POR_INCERTEZA",
        "COMPLEMENTACAO_DOCUMENTAL",
        "ANALISE_COMUM",
        null
      ]
    },
    "gatilhos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "descricao",
          "evidencias_ids",
          "regras_ids"
        ],
        "properties": {
          "descricao": {
            "type": "string",
            "minLength": 1
          },
          "evidencias_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "regras_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "achados_secundarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "descricao",
          "evidencias_ids",
          "regras_ids"
        ],
        "properties": {
          "descricao": {
            "type": "string",
            "minLength": 1
          },
          "evidencias_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "regras_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
